{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Agent Invocations (Rate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(agent_invocations_total[5m])",
          "legendFormat": "{{agent_type}} - {{status}}"
        }
      ]
    },
    {
      "title": "API Request Latency (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(agent_api_request_duration_seconds_bucket[5m]))",
          "legendFormat": "{{endpoint}} p95"
        }
      ]
    },
    {
      "title": "Total Requests",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(agent_api_requests_total)"
        }
      ]
    },
    {
      "title": "Error Rate",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(agent_api_requests_total{status_code=~'5..'}[5m])) / sum(rate(agent_api_requests_total[5m])) * 100",
          "legendFormat": "Error %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    },
    {
      "title": "Benchmark Runs",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(benchmark_runs_total)"
        }
      ]
    },
    {
      "title": "Active Tokens Used",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(agent_api_requests_total[1h]))"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["enterprise-ai", "agents"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "title": "Enterprise Agent AI — Performance",
  "uid": "enterprise-agent-performance"
}
