# =============================================================================
# Enterprise Agent AI & LLM Integration — Environment Variables
# =============================================================================
# Copy this file to .env and fill in values as needed.
# Mock providers are used by default — real API keys are optional.

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# -----------------------------------------------------------------------------
# LLM Providers (Optional — mock providers used if not set)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Default LLM provider: openai | anthropic | google | mock
DEFAULT_LLM_PROVIDER=mock
DEFAULT_MODEL_NAME=mock-gpt-4o

# -----------------------------------------------------------------------------
# Database (PostgreSQL + pgvector)
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=enterprise_ai
POSTGRES_USER=enterprise
POSTGRES_PASSWORD=enterprise_secret_password
DATABASE_URL=postgresql+asyncpg://enterprise:enterprise_secret_password@postgres:5432/enterprise_ai

# -----------------------------------------------------------------------------
# Agent API Service
# -----------------------------------------------------------------------------
AGENT_API_HOST=0.0.0.0
AGENT_API_PORT=8000
AGENT_API_WORKERS=4

# Embedding model
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# RAG Settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=5

# -----------------------------------------------------------------------------
# LLM Evaluator Service
# -----------------------------------------------------------------------------
EVALUATOR_HOST=0.0.0.0
EVALUATOR_PORT=8001
EVALUATOR_WORKERS=2

# Benchmark Settings
MAX_CONCURRENT_EVALUATIONS=5
BENCHMARK_TIMEOUT_SECONDS=300

# -----------------------------------------------------------------------------
# C# Gateway
# -----------------------------------------------------------------------------
GATEWAY_PORT=8080

# JWT Settings
JWT_SECRET_KEY=your-256-bit-secret-key-change-in-production
JWT_ISSUER=enterprise-ai-gateway
JWT_AUDIENCE=enterprise-ai-services
JWT_EXPIRY_MINUTES=60

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST=20

# Backend Service URLs
AGENT_API_URL=http://agent-api:8000
EVALUATOR_API_URL=http://llm-evaluator:8001

# -----------------------------------------------------------------------------
# Monitoring
# -----------------------------------------------------------------------------
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin

# OpenTelemetry (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=enterprise-agent-ai
